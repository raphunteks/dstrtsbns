# ─────────────────────────────────────────────────────────────
# Daster Tasbon Olshop — daftar variabel environment.
# Salin ke .env (lokal) atau isi di dashboard Vercel / file .env di VPS.
# JANGAN commit nilai asli. JANGAN beri prefix NEXT_PUBLIC_ pada rahasia.
# ─────────────────────────────────────────────────────────────

# ── Aplikasi ─────────────────────────────────────────────────
APP_URL=http://localhost:3000            # URL publik tanpa garis miring akhir (dipakai webhook & pg_cron)
DEPLOY_TARGET=vercel                     # vercel | vps
CRON_SECRET=                             # string acak ≥32 karakter, dikirim pg_cron di header x-cron-secret
STORE_TIMEZONE=Asia/Makassar             # OD-012: zona waktu tampilan toko (konfirmasi owner)

# ── Supabase: publik (boleh terlihat browser) ────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # format key baru; isi salah satu dari ANON / PUBLISHABLE

# ── Supabase: RAHASIA (server saja) ──────────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=                     # format baru; atau isi SUPABASE_SERVICE_ROLE_KEY (format lama)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Postgres (Prisma) ────────────────────────────────────────
# WAJIB diakhiri parameter schema=app. Tanpa itu tabel & query jatuh ke schema "public"
# yang diekspos Data API Supabase. Aplikasi menolak start bila parameter ini tidak ada.
#   pooled  : postgresql://...:6543/postgres?pgbouncer=true&connection_limit=1&schema=app
#   direct  : postgresql://...:5432/postgres?schema=app
POSTGRES_PRISMA_URL=                     # pooled (pgbouncer) — runtime
POSTGRES_URL_NON_POOLING=                # direct — migrasi
# Variabel di bawah dibuat otomatis oleh integrasi Vercel–Supabase; tidak dipakai kode.
POSTGRES_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ── Pakasir API v2 (Fase 4) ──────────────────────────────────
PAKASIR_BASE_URL=https://app.pakasir.com/api/v2
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=                  # nilai X-Secret yang dikirim Pakasir
PAKASIR_IS_SANDBOX=true

# ── RajaOngkir Shipping Cost (Fase 3) ────────────────────────
RAJAONGKIR_COST_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_COST_API_KEY=

# ── Komerce Shipping Delivery — Enterprise (opsional, OD-013) ─
KOMERCE_DELIVERY_ENABLED=false
KOMERCE_DELIVERY_BASE_URL=https://api-sandbox.collaborator.komerce.id
KOMERCE_DELIVERY_API_KEY=
